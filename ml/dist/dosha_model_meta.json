{
 "model_file": "dosha_model.tflite",
 "version": 2,
 "trained_on": "2026-10-31",
 "algorithm": "multinomial logistic regression (softmax), soft constitution targets, adaptive tie-breakers",
 "test_accuracy_stage1": 0.8878,
 "test_accuracy_adaptive": 0.8975,
 "input": {
  "name": "serving_default_features_one_hot:0",
  "shape": [
   1,
   126
  ],
  "dtype": "float32",
  "base_block": "indices 0..89: one_hot[question_index * 3 + option_index] = 1.0; option_index 0 = option A (Vata), 1 = option B (Pitta), 2 = option C (Kapha)",
  "tiebreaker_block": "indices 90..125: one_hot[90 + bank_index * 12 + question_index * 2 + option_index] = 1.0; leave the whole block 0 when no tie-breaker round was asked"
 },
 "output": {
  "name": "StatefulPartitionedCall_1:0",
  "shape": [
   1,
   3
  ],
  "dtype": "float32",
  "classes": [
   "Vata",
   "Pitta",
   "Kapha"
  ],
  "meaning": "probabilities, sum to 1; index 0 = Vata, 1 = Pitta, 2 = Kapha"
 },
 "adaptive_flow": {
  "confidence_threshold": 0.7,
  "rule": "run once with the base block only; if max(probs) < confidence_threshold, ask the tie-breaker bank whose pair is the two highest doshas, fill its block and run again"
 },
 "type_rule": {
  "tridoshic_if_every_dosha_at_least": 0.25,
  "dual_if_second_dosha_at_least": 0.3,
  "otherwise": "single dominant dosha"
 },
